{
  "info": {
    "name": "Enterprise PPM Suite API",
    "description": "Postman collection for the Enterprise Project & Performance Management Suite backend.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "projectId", "value": "1" },
    { "key": "taskId", "value": "1" },
    { "key": "kpiId", "value": "1" },
    { "key": "reportId", "value": "1" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"AdminPass123!\"\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/refresh",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api", "auth", "refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Projects & Tasks",
      "item": [
        {
          "name": "GET /api/projects",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] }
          }
        },
        {
          "name": "POST /api/projects",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/projects", "host": ["{{baseUrl}}"], "path": ["api", "projects"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Platform Revamp\",\n  \"description\": \"Modernize platform services\",\n  \"organizationId\": 1,\n  \"status\": \"PLANNED\"\n}"
            }
          }
        },
        {
          "name": "GET /api/projects/{id}",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}"] }
          }
        },
        {
          "name": "POST /api/projects/{id}/tasks",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}", "tasks"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Design KPI ingestion\",\n  \"description\": \"Implement event-driven ingestion endpoint\",\n  \"priority\": \"HIGH\"\n}"
            }
          }
        },
        {
          "name": "PATCH /api/projects/{id}/tasks/{taskId}",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}", "tasks", "{{taskId}}"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"priority\": \"CRITICAL\"\n}"
            }
          }
        },
        {
          "name": "POST /api/projects/{id}/tasks/order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/projects/{{projectId}}/tasks/order", "host": ["{{baseUrl}}"], "path": ["api", "projects", "{{projectId}}", "tasks", "order"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"taskIds\": [1,2,3]\n}"
            }
          }
        }
      ]
    },
    {
      "name": "KPIs",
      "item": [
        {
          "name": "GET /api/kpis",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/kpis", "host": ["{{baseUrl}}"], "path": ["api", "kpis"] }
          }
        },
        {
          "name": "POST /api/kpis",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/kpis", "host": ["{{baseUrl}}"], "path": ["api", "kpis"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Release Throughput\",\n  \"description\": \"Releases per month\",\n  \"unit\": \"count\",\n  \"targetValue\": 12,\n  \"organizationId\": 1\n}"
            }
          }
        },
        {
          "name": "POST /api/kpis/{id}/readings",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/kpis/{{kpiId}}/readings", "host": ["{{baseUrl}}"], "path": ["api", "kpis", "{{kpiId}}", "readings"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"value\": 10.5,\n  \"source\": \"jenkins\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Reports",
      "item": [
        {
          "name": "POST /api/reports",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": { "raw": "{{baseUrl}}/api/reports", "host": ["{{baseUrl}}"], "path": ["api", "reports"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"format\": \"PDF\",\n  \"parameters\": {\n    \"projectId\": 1,\n    \"period\": \"Q1-2026\"\n  }\n}"
            }
          }
        },
        {
          "name": "GET /api/reports/{id}/download",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/reports/{{reportId}}/download", "host": ["{{baseUrl}}"], "path": ["api", "reports", "{{reportId}}", "download"] }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "GET /api/dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": { "raw": "{{baseUrl}}/api/dashboard", "host": ["{{baseUrl}}"], "path": ["api", "dashboard"] }
          }
        }
      ]
    }
  ]
}
